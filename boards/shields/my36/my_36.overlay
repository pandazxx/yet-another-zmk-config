#include <dt-bindings/zmk/matrix_transform.h> // Put this with the other includes at the top of your overlay
#include <input/processors.dtsi>              // zip_xy_scaler & friends

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
        // Other chosen items
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <3>; // Length of the "col-gpios" array
        rows = <3>; // Length of the "row-gpios" array
        map = <
        //   Key 1 | Key 2 | Key 3
            RC(0,0) RC(0,1) RC(0,2)
        //   Key 4 | Key 5 | Key 6
            RC(1,0) RC(1,1) RC(1,2)
        //   Key 7 | Key 8 | Key 9
            RC(2,0) RC(2,1) RC(2,2)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    physical_layout0: physical_layout_0 { // First physical layout, use different naming for other layouts
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
    };

    // ------------------------------------------------------------------
    // BlackBerry trackball breakout
    //
    // Module -> nice!nano (right hand column, VCC downwards):
    //   VCC -> VCC (3.3V)      GND -> GND
    //   UP  -> D21             DWN -> D20
    //   LFT -> D19             RHT -> D18
    //   BTN -> D15
    //   BLU / RED / GRN / WHT are the trackball's LEDs, leave unconnected.
    //
    // The direction pins are pushed high by the breakout, so no internal
    // bias is requested here. If the module leaves them floating (phantom
    // cursor movement while the ball is still), add GPIO_PULL_DOWN.
    // ------------------------------------------------------------------
    trackball: trackball {
        compatible = "zmk,input-bb-trackball";
        status = "okay";

        up-gpios    = <&pro_micro 21 GPIO_ACTIVE_HIGH>;
        down-gpios  = <&pro_micro 20 GPIO_ACTIVE_HIGH>;
        left-gpios  = <&pro_micro 19 GPIO_ACTIVE_HIGH>;
        right-gpios = <&pro_micro 18 GPIO_ACTIVE_HIGH>;
        btn-gpios   = <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        report-interval-ms = <10>;
    };

    // The ball only emits ~9 pulses per revolution and per axis, so the raw
    // deltas have to be multiplied up heavily: a thumb swipe is well under a
    // full revolution, i.e. only a handful of pulses. The first parameter of
    // zip_xy_scaler is the knob; it is also the cursor's step size in pixels,
    // so raising it buys speed at the cost of a coarser, steppier cursor.
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_xy_scaler 64 1>;
    };
};
