#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // ---------------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |   LCLK    |   RCLK    |   MCLK    |
            bindings = <
                &kp Z        &kp M        &kp K
                &kp A        &kp B        &kp C
                &mkp LCLK    &mkp RCLK    &mkp MCLK
            >;
        };
    };
};
