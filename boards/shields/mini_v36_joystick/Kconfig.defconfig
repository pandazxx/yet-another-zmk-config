if SHIELD_MINI_V36_JOYSTICK

config ZMK_KEYBOARD_NAME
    default "Mini V36 Joystick"

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

# ── Analog joystick driver dependencies ───────────────────────────────────
if MINI_V36_JOYSTICK_TYPE_ANALOG

config ADC
    default y

config ANALOG_AXIS
    default y

config INPUT
    default y

endif # MINI_V36_JOYSTICK_TYPE_ANALOG

# ── 5-way tactile switch driver dependencies ──────────────────────────────
if MINI_V36_JOYSTICK_TYPE_5WAY

config INPUT
    default y

config GPIO_KEYS
    default y

endif # MINI_V36_JOYSTICK_TYPE_5WAY

endif # SHIELD_MINI_V36_JOYSTICK
