if SHIELD_MINI_V36_JOYSTICK

config ZMK_KEYBOARD_NAME
    default "Mini V36 Jstk"

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

# Driver dependencies for each joystick type are set in the .conf files
# (config/mini_v36_joystick.conf and mini_v36_joystick.conf) rather than
# here, because Kconfig.defconfig is parsed globally for all shields and
# ANALOG_AXIS / GPIO_KEYS may not be defined upstream in this ZMK version.

endif # SHIELD_MINI_V36_JOYSTICK
